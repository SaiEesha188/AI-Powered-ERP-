# Superuser connection, used only by `pnpm db:setup` to create the database, roles and run migrations.
ADMIN_DATABASE_URL=postgres://postgres@localhost:5433/postgres

# The API connects as two roles:
#   erp_app    - row-level security enforced; used for every tenant-scoped request
#   erp_system - bypasses RLS; used only for auth, tenant provisioning and background jobs
DATABASE_URL=postgres://erp_app:erp_app_dev@localhost:5433/erp
SYSTEM_DATABASE_URL=postgres://erp_system:erp_system_dev@localhost:5433/erp

# At least 32 characters. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

PORT=3000
# console = print OTPs to the API log (development only)
SMS_PROVIDER=console

# Links sent to families (circulars, files) start with this.
PUBLIC_APP_URL=http://localhost:3000
# Uploaded files (development). Defaults to %LOCALAPPDATA%\erp-dev\files.
# FILE_STORAGE_DIR=

# WhatsApp: console prints messages to the API log. Set meta plus the values below for real sends.
WHATSAPP_PROVIDER=console
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=      # verifies delivery/read webhooks
# WHATSAPP_VERIFY_TOKEN=    # webhook subscription handshake

# Background notification worker inside the API process (on/off).
NOTIFICATIONS_WORKER=on
