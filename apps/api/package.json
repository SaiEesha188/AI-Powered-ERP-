{
  "name": "@erp/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev": "concurrently -k -n tsc,api \"tsc -b -w --preserveWatchOutput\" \"node --watch-path=dist --watch-path=../../packages/db/dist --watch-path=../../packages/shared/dist --wait-for-file=dist/main.js dist/main.js\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@erp/db": "workspace:*",
    "@erp/shared": "workspace:*",
    "@nestjs/common": "12.3.2",
    "@nestjs/core": "12.3.2",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.2",
    "exceljs": "4.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.3.2",
    "@swc/core": "1.16.21",
    "@types/express": "5.0.6",
    "@types/multer": "2.3.0",
    "@types/node": "26.6.6",
    "@types/supertest": "7.2.1",
    "concurrently": "^10.0.6",
    "supertest": "7.3.1",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.0.5"
  }
}
